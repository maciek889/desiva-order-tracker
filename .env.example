# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string (matches docker-compose.yml for local dev)
DATABASE_URL="postgresql://desiva:desiva@localhost:5432/desiva?schema=public"

# JWT signing secret — generate with: openssl rand -base64 48
JWT_SECRET=""

# Cloudflare R2 (S3-compatible) storage for order attachments
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Only used by scripts/migrate-to-r2.ts (one-off migration of legacy local uploads)
UPLOAD_DIR="./public/uploads"
